{
  "name": "@ubiquity-os-marketplace/command-config",
  "version": "1.0.0",
  "description": "Use plain english to change our organization configs for UbiquityOS.",
  "author": "Ubiquity DAO",
  "license": "MIT",
  "main": "src/worker.ts",
  "type": "module",
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "format": "run-p format:*",
    "check-formatting": "run-p check-formatting:* format:cspell",
    "check-formatting:lint": "eslint --fix-dry-run",
    "format:lint": "eslint --fix .",
    "format:prettier": "prettier --write .",
    "check-formatting:prettier": "prettier --check .",
    "format:cspell": "cspell .",
    "knip": "knip --config .github/knip.ts",
    "knip-ci": "knip --no-exit-code --reporter json --config .github/knip.ts",
    "jest:test": "jest --coverage",
    "worker": "wrangler dev --env dev --port 4000",
    "start": "bun --port 4000 --watch --no-clear-screen src/worker.ts",
    "prepare": "bun run prepare:manifest && husky",
    "prepare:manifest": "bun x @ubiquity-os/plugin-manifest-tool@latest .",
    "prebuild": "bun run prepare:manifest"
  },
  "keywords": [
    "typescript",
    "template",
    "dao",
    "ubiquity",
    "open-source"
  ],
  "dependencies": {
    "@sinclair/typebox": "0.34.47",
    "@ubiquity-os/plugin-sdk": "3.11.0",
    "@ubiquity-os/ubiquity-os-logger": "^1.4.0",
    "openai": "^4.86.2",
    "prettier": "3.4.2"
  },
  "devDependencies": {
    "@commitlint/cli": "19.6.1",
    "@commitlint/config-conventional": "19.6.0",
    "@cspell/dict-node": "5.0.6",
    "@cspell/dict-software-terms": "4.2.4",
    "@cspell/dict-typescript": "3.2.0",
    "@eslint/js": "9.19.0",
    "@jest/globals": "30.2.0",
    "@mswjs/data": "0.16.2",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "cspell": "8.17.3",
    "dotenv": "^17.2.3",
    "eslint": "9.19.0",
    "eslint-plugin-check-file": "3.0.0",
    "eslint-plugin-sonarjs": "3.0.1",
    "husky": "9.1.7",
    "jest": "30.2.0",
    "jest-junit": "16.0.0",
    "jest-md-dashboard": "0.8.0",
    "knip": "^5.60.2",
    "lint-staged": "15.4.3",
    "npm-run-all": "4.1.5",
    "ts-node": "^10.9.2",
    "typescript": "5.6.2",
    "typescript-eslint": "8.22.0",
    "wrangler": "3.102.0"
  },
  "lint-staged": {
    "*.ts": [
      "prettier --write",
      "eslint --fix"
    ],
    "src/**.{ts,json}": [
      "cspell"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "packageManager": "bun@1"
}
